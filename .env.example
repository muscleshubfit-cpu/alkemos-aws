# =====================================================================
#  Alkemos — Environment variables
#  Copy this file to `.env.local` for local dev, or set the same keys
#  in your Vercel project settings → Environment Variables.
# =====================================================================

# --- Supabase (required for production auth + data) ---
# Find these in your Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# (The ops scripts scripts/db-backup.mjs · db-restore.mjs · retro-pair-blog.mjs
# also accept SUPABASE_URL as an alias of NEXT_PUBLIC_SUPABASE_URL.)

# When the two keys above are missing, the app runs in a local-only
# "demo mode" backed by localStorage — useful for previews & testing.
# Two demo accounts are auto-seeded in demo mode (source: src/lib/data/auth.ts):
#   ahmed@coach.app / coach123   (logs in as the coach)
#   client@demo.app / client123  (logs in as a demo client)

# --- Email sending (Brevo REST API — HTTPS; Vercel serverless blocks
#     outbound SMTP ports 25/465/587, so the REST API over 443 is used) ---
# Used by POST /api/send-email to deliver tool results to visitors.
# Already configured on Vercel (owner) — same free Brevo account that
# serves the Supabase custom SMTP relay (auth emails). Free tier: 300/day.
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM="Alkemos <no-reply@alkemos.com>"
# Optional reply-to override (SET in Vercel production):
EMAIL_REPLY_TO=support@alkemos.com


# =====================================================================
# =====================================================================
#  AI System (Gemini + OpenRouter + Groq + NVIDIA NIM — Gemini added
#  2026-10-06 by owner order «أضف Gemini كمزود AI جديد...واجعله الاختيار
#  الأول» — FREE tier, native generativelanguage adapter; before that:
#  NVIDIA added 2026-09-09, three-provider law since Phase 161)
# =====================================================================
#
# The platform talks to EXACTLY FOUR providers through a single unified
# layer (src/lib/ai-provider.ts):
#
#   1. GEMINI      -> FIRST CHOICE of both chains when GEMINI_API_KEY is
#                     set (blog pipeline + AI plans + EVO chat) — FREE
#                     tier; native REST (x-goog-api-key), NOT OpenAI-shape
#                     (GEMINI_API_KEY)
#   2. OpenRouter  -> primary non-gemini default, free models chain
#                     (OPENROUTER_API)
#   3. Groq        -> interleaved fallback (GROQ_API_KEY)
#   4. NVIDIA NIM  -> integrate.api.nvidia.com, OpenAI-compatible
#                     (NVIDIA_API_KEY)
#
# Missing GEMINI_API_KEY = pre-343 behavior verbatim (the chain skips the
# gemini entries without consuming attempt budget — rollback without code).
# The OpenAI / Anthropic / DeepSeek direct integrations remain REMOVED. If
# you want a Google model via OpenRouter, the google/gemma-* ids stay DEAD
# (Phase 177 purge) — use the native gemini arm instead.
#
# Gemini usage is tracked per-tag to Upstash (UPSTASH pair below) and
# reported weekly in docs/ai/gemini-weekly-usage-report.md.
#
# NOTE the exact spelling: the OpenRouter key env var is
#   OPENROUTER_API        <- used by the code (and older docs)
#   OPENROUTER_API_KEY    <- accepted as an alias of the above
# Set at least ONE of them, plus GROQ_API_KEY and NVIDIA_API_KEY for
# full reliability (GEMINI_API_KEY activates the gemini-first arm; the
# same keys live in Vercel Production and GitHub Actions secrets).
#
# Optional overrides:
# AI_PROVIDER=openrouter      # openrouter | groq | nvidia | gemini
# AI_MODEL=                   # force a specific model for getEnvConfig()
# AI_BASE_URL=                # custom OpenAI-compatible endpoint

OPENROUTER_API=
# OPENROUTER_API_KEY=        # alias of OPENROUTER_API (either works)
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY2=             # optional (blog recovery 2026-10-16): SECOND free-tier Google AI key for the
                            # grounded-search ladder — Gemini bills the Google-Search grounding quota PER
                            # PROJECT (live-probed: primary key's grounded quota drained on every model
                            # family while its NON-grounded calls succeed), so a new key = new project =
                            # an INDEPENDENT grounded bucket. Absent/empty = single-key behavior. Consumed
                            # by callGeminiGroundedSearch (P0 research); the chain stays on the primary.
GEMINI_MODEL=               # optional (default gemini-3.5-flash since Phase 344; was gemini-3.8-flash)
GEMINI_GROUNDED_MODELS=     # optional (blog recovery 2026-10-16): comma-separated alternate models for the
                            # grounded-search ladder AFTER the default (built-in cross-family tail: gemini-3.8-flash,
                            # gemini-3.5-flash-lite — each family bills its OWN quota bucket, so a 429 on one
                            # falls through to the next REAL googleSearch-grounded call; live-probed retirements:
                            # gemini-2.5-flash 404 «no longer available to new users» · gemini-3.8-pro 404 «not
                            # found for API version v1beta» on the live key — both excluded since measured).
                            # Source: src/lib/ai-provider.ts, callGeminiGroundedSearch.

P0_PAIR_GAP_MS=             # optional (blog recovery 2026-10-20 — P0-PAIR-SERIAL): recovery gap in ms between
                            # the TWO languages' grounded research walks in the P0 CREATE path. The pair now runs
                            # SEQUENTIALLY (never Promise.all-concurrent — two simultaneous agentic walks on the
                            # single working free-tier grounded arm starved each other and killed 15 daily runs);
                            # when the first language lands on groq, the twin waits this gap for the per-minute
                            # token/tool bucket to recover. Default 90000 (measured-safe); 0 disables the gap
                            # (serialization itself is unconditional); ceiling clamps at 600000.
                            # Source: src/lib/blog-research.ts, runBilingualResearchPair.

# --- Cross-provider grounded-search failover (BLOG-PROVIDER-FAILOVER
#     2026-10-16, owner order «افحص وأصلح آلية التبديل التلقائي بين مزوّدي
#     الذكاء الاصطناعي الحاليين») — P0 research now walks REAL-search arms:
#     gemini(googleSearch) → openrouter(web plugin) → groq(browser_search —
#     GROQ-2 2026-10-17: the compound-successor tool, see below);
#     NVIDIA NIM is honestly excluded (no web-search tool in its chat API).
#     Every arm enforces the live-evidence gate — no plain generation or
#     fake results can pass as research. No NEW keys: the EXISTING provider
#     keys are reused per arm. ---
OPENROUTER_GROUNDED_MODEL=  # optional: model for the OpenRouter web-plugin grounded arm
                            # (default nvidia/nemotron-3-super-120b-a12b:free — an existing
                            # live-verified free-chain id). The web plugin bills per-search
                            # credits on the existing key; no credits → honest 402 → groq arm.
GROQ_GROUNDED_MODEL=        # optional (GROQ-2 2026-10-17): LEADER model for the Groq grounded
                            # arm (default openai/gpt-oss-120b — the browser_search built-in
                            # tool; Groq DECOMMISSIONED the compound system 2026-09-21, so the
                            # old default compound-beta 404s permanently).
GROQ_GROUNDED_MODELS=       # optional (GROQ-2 2026-10-17): comma-separated FALLBACK models for
                            # the Groq grounded ladder AFTER the leader (built-in tail:
                            # openai/gpt-oss-20b). Each entry is a REAL browser_search call —
                            # a dead/drained id falls through to the next live model.
AI_PROVIDER_COOLDOWN_MS=    # optional (blog workflows set 1800000): quota-cooldown window for the
                            # provider failover — exhaustion-class failures (429/402/401/403/404)
                            # cool the failed provider/key×model and the chain/grounded walk SKIPS
                            # it (no futile repeat, no attempt-budget burn). ABSENT = disabled =
                            # byte-identical pre-2026-10-16 behavior. Kill-switch: AI_PROVIDER_COOLDOWN=0.
AI_PROVIDER_COOLDOWN=       # optional: set to 0 to force-disable the cooldown registry (rollback).
AI_COOLDOWN_STATE_FILE=     # optional: path of the cooldown state file (default
                            # ${TMPDIR}/alkemos-ai-provider-cooldown.json) — persists across the
                            # steps of one GitHub Actions job; contains NO secrets.

# --- Supabase service role (SERVER-ONLY — cron routes + admin APIs) ---
# Grants FULL DB access bypassing RLS. NEVER prefix with NEXT_PUBLIC_,
# never expose to the browser, never commit a real value. Required by
# the blog pipeline cron routes (/api/cron/blog/*), the AI-jobs runner
# and the admin server routes. Find it in Supabase → Project Settings
# → API → service_role key. Also a GitHub Actions secret
# (SUPABASE_SERVICE_ROLE_KEY) for the native runners.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL (public metadata base) ---
# Used by sitemap, OG images, RSS, email links, canonical tags.
NEXT_PUBLIC_SITE_URL=https://alkemos.com

# --- Cron auth + scheduler independence (SCHEDULE HEALTH LAW §8) ---
# CRON_SECRET: shared secret for /api/cron/* routes (Vercel Cron sends
# it as Authorization: Bearer). Also a GitHub Actions secret.
# GITHUB_DISPATCH_TOKEN: fine-grained GitHub PAT (THIS repo only,
# Actions: Read and write ONLY) letting /api/cron/dispatch-pipelines
# top up missed blog pipeline slots and rescue the ai-jobs worker when
# GitHub's scheduler de-registers. Vercel env only — never a repo secret.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=

# --- Blog images (IMAGE SOURCE LAW v3 — Pexels-first) ---
# AI image generation is RETIRED (law v3); every blog image is real
# stock photography. PEXELS_API_KEY is the PRIMARY source (required in
# GitHub Actions secrets AND Vercel Production); Unsplash/Pixabay are
# failover. Pixabay queries run with safesearch=true (modesty law).
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# --- EVO coach follow-up email (Phase 166/170 — opt-in, live) ---
# Master switch for /api/evo/followup/dispatch (404 when not "true").
# EVO_FOLLOWUP_FROM overrides the sender (default evo@alkemos.com,
# send-only); EVO_CRON_SECRET is that route's own x-cron-secret — a
# SEPARATE, independently-rotatable secret from CRON_SECRET, verified
# with the same timing-safe comparison (P1-6; SECURITY.md §3.3).
EVO_FOLLOWUP_ENABLED=
# Both set in Vercel production (FROM is the send-only sender,
# EVO_CRON_SECRET is independently rotatable from CRON_SECRET):
EVO_FOLLOWUP_FROM=evo@alkemos.com
EVO_CRON_SECRET=

# --- Blog research note ---
# Blog P0 research is model-knowledge based via the same
# OpenRouter/Groq/NVIDIA chain (no live web grounding exists on those
# gateways). No extra env vars are required for research anymore.

# --- Blog AR Latin-repair rollback (R2, 2026-09-29 — NOT a secret) ---
# EMPTY/absent (default) = the localized repair: deterministic
# dictionary pass first, then a token-only small conversion call
# (Groq-eligible). Set to "1" ONLY to roll back to the pre-R2
# full-article repair call (debug/rollback lever; the gates are
# byte-identical either way). Documented in SECURITY.md §2.2.
LATIN_REPAIR_LEGACY=

# --- R3 Groq per-entry clamp rollback (Execution-Path Audit 2026-09-29) ---
# EMPTY/absent (default) = the R3 per-entry clamp: when a call's estimated
# size exceeds Groq's 8k TPM window, groq entries STAY in the chain with
# their own max_tokens clamped to the remaining window — kept only while
# the clamp stays >= 3800 output tokens (P2 content re-enters Groq; P4
# review stays openrouter/nvidia-only by design). Set to "0" ONLY to roll
# back to the pre-R3 behavior (drop ALL groq entries when the estimate
# exceeds the window). Documented in SECURITY.md §2.2 + AGENTS.md §8.
GROQ_MAX_TOKENS_CLAMP=

# --- PayPal (Primary Payment Method) ---
# Sandbox mode is used for development. Live mode will be enabled later.
#
# SECURITY:
# - PAYPAL_CLIENT_SECRET is SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# - PAYPAL_CLIENT_ID is also server-only (used for server-side Order API).
# - NEXT_PUBLIC_PAYPAL_CLIENT_ID is the PUBLIC client ID used by the
#   PayPal JS SDK in the browser (safe to expose — PayPal's design).
#
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
# Create a Sandbox app → get Client ID + Secret + Webhook ID.
#
# Set these in Vercel → Project Settings → Environment Variables.
# Do NOT commit real Sandbox or Live credentials to Git.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ============================================================
# Optional: public analytics + ads + coach promotion allowlist
# (P3-2, deep-audit confirmed 24 — Phase 217: these were documented in
# README's setup table but missing here, so local clones warned about
# every one of them).
# ============================================================
# Google Analytics 4 measurement ID (public by design — NEXT_PUBLIC_).
NEXT_PUBLIC_GA_ID=
# Google AdSense publisher id (ca-pub-…, public by design).
NEXT_PUBLIC_ADSENSE_CLIENT=
# Comma-separated allowlist: emails here are auto-promoted to coach on
# signup (coach_emails table, 0017 — never downgrades an admin).
COACH_EMAILS=

# ============================================================
# Optional: distributed rate limiting (Upstash Redis free tier)
# Shared rate-limit counters across serverless instances via REST.
# Falls back to per-instance in-memory Map when unset.
# Console: https://console.upstash.com -> Create Database -> REST API
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
